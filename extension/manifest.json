{
  "manifest_version": 3,
  "name": "Codex认证助手 (Fork)",
  "short_name": "Codex Auth Helper",
  "version": "1.2.0",
  "description": "Fork：从已登录的 ChatGPT 网页会话导出 auth.json。修正 refresh_token 为空、last_refresh、过期时间对齐与导出前校验。仅本地处理。",
  "permissions": [
    "downloads"
  ],
  "host_permissions": [
    "https://chatgpt.com/"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}